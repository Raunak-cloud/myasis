{
  "name": "seek-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Patchright + Celeris job search and auto-apply agent for SEEK and Indeed",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "tsc && node dist/main.js",
    "dev": "tsx src/main.ts",
    "search": "tsx src/main.ts --search-only",
    "capture": "tsx src/discovery.ts --capture",
    "test:e2e": "tsc && node dist/e2e.js",
    "test:external": "tsc && node dist/external-e2e.js",
    "test:external-real": "tsc && node dist/external-real-rehearsal.js",
    "test:agent": "tsc && node dist/agent-e2e.js",
    "test:model-forms": "tsc && node dist/model-forms.test.js",
    "test:cover-letter": "tsc && node dist/agent/cover-letter-opportunity.test.js",
    "test:combobox": "tsc && node scripts/test-combobox.mjs",
    "test:pipeline": "tsc && node scripts/test-pipeline.mjs",
    "test:capmonster": "tsc && node scripts/test-capmonster.mjs",
    "test:ranking": "tsc && node scripts/test-ranking.mjs",
    "test:review-cache": "tsc && node --test dist/review-cache.test.js",
    "test:humanizer-endpoint": "tsc && node scripts/test-humanizer-endpoint.mjs",
    "test:fit-live": "tsc && node scripts/test-fit-live.mjs",
    "queue": "tsc && node dist/queue.js",
    "test:agent-speed": "tsc && node dist/agent-speed.test.js",
    "test:fill-verify": "tsc && node dist/fill-verify.test.js",
    "test:reconcile": "tsc && node dist/agent/reconcile.test.js",
    "test:resume-sync": "tsc && node dist/resume-sync.test.js",
    "test:pacing": "tsc && node --test dist/pacing.test.js",
    "test:hcaptcha": "tsc && node dist/captcha/hcaptcha.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mammoth": "^1.12.3",
    "patchright": "^1.63.0",
    "pdf-parse-fork": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
