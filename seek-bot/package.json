{
  "name": "seek-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Patchright + Gemini job search and auto-apply agent for SEEK",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/main.js",
    "dev": "tsx src/main.ts",
    "search": "tsx src/main.ts --search-only",
    "capture": "tsx src/discovery.ts --capture",
    "test:e2e": "tsc && node dist/e2e.js",
    "test:external": "tsc && node dist/external-e2e.js",
    "test:external-real": "tsc && node dist/external-real-rehearsal.js",
    "test:agent": "tsc && node dist/agent-e2e.js",
    "test:model-forms": "tsc && node dist/model-forms.test.js",
    "test:combobox": "tsc && node scripts/test-combobox.mjs",
    "test:pipeline": "tsc && node scripts/test-pipeline.mjs",
    "test:capmonster": "tsc && node scripts/test-capmonster.mjs",
    "test:ranking": "tsc && node scripts/test-ranking.mjs",
    "test:humanizer-endpoint": "tsc && node scripts/test-humanizer-endpoint.mjs",
    "test:fit-live": "tsc && node scripts/test-fit-live.mjs",
    "queue": "tsc && node dist/queue.js",
    "bench:fit": "tsc && node dist/bench-fit.js",
    "bench:letter": "tsc && node dist/bench-letter.js",
    "bench:humanizer": "tsc && node dist/bench-humanizer.js"
  },
  "dependencies": {
    "@google/genai": "^0.14.0",
    "dotenv": "^16.4.7",
    "mammoth": "^1.12.3",
    "pdf-parse-fork": "^1.2.0",
    "patchright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
