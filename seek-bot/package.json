{
  "name": "seek-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Patchright + Celeris job search and auto-apply agent for SEEK and Indeed",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "tsc && node dist/main.js",
    "dev": "tsx src/main.ts",
    "search": "tsx src/main.ts --search-only",
    "capture": "tsx src/discovery.ts --capture",
    "test:e2e": "tsc && node dist/e2e.js",
    "test:external": "tsc && node dist/external-e2e.js",
    "test:external-real": "tsc && node dist/external-real-rehearsal.js",
    "test:agent": "tsc && node dist/agent/agent-only.test.js",
    "test:agent-screenshots": "tsc && node --test dist/agent/agent-only-transcript.test.js && node dist/agent/agent-screenshots.test.js",
    "test:agent-screenshots-live": "tsc && node scripts/test-screenshot-agent-live.mjs --live",
    "test:agent-facts-live": "tsc && node scripts/test-agent-owned-facts-live.mjs --live",
    "test:cover-letter": "tsc && node dist/agent/cover-letter-opportunity.test.js",
    "test:assessment-reuse": "tsc && node dist/assessment-reuse.test.js",
    "test:capmonster": "tsc && node scripts/test-capmonster.mjs",
    "test:ranking": "tsc && node scripts/test-ranking.mjs",
    "test:review-cache": "tsc && node --test dist/review-cache.test.js",
    "test:fit-live": "tsc && node scripts/test-fit-live.mjs",
    "queue": "tsc && node dist/queue.js",
    "test:pacing": "tsc && node --test dist/pacing.test.js",
    "test:hcaptcha": "tsc && node dist/captcha/hcaptcha.test.js",
    "test:plan-loop": "tsc && node dist/agent/agent-only.test.js",
    "test:labels": "tsc && node dist/labels.test.js",
    "test:form-replay": "tsc && node dist/form-replay.test.js",
    "replay": "node dist/form-replay.js",
    "test:email-wait": "tsc && node dist/gmail-mcp.test.js",
    "test:headless-fixtures": "tsc && node scripts/test-headless-fixtures.mjs",
    "test:native-browser": "tsc && node --test dist/agent/native-browser.test.js",
    "test:application-reliability": "tsc && node --test dist/agent/application-readiness.test.js dist/agent/recovery-checkpoint.test.js dist/agent/progress-budget.test.js dist/agent/native-browser.test.js && node dist/agent/application-readiness-browser.test.js && node dist/agent/agent-batch-browser.test.js",
    "test:saved-form": "tsc && node dist/application-review.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^16.4.7",
    "google-auth-library": "^11.3.1",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.3",
    "patchright": "^1.63.0",
    "pdf-parse-fork": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
