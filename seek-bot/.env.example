# --- Payments (Stripe-hosted Checkout) ---
# Use test keys while developing. Checkout stays disabled until both secrets are set.
APP_BASE_URL=http://localhost:5180
ADMIN_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# --- Gemini (cover letters only) ---
# Every other model call runs on Celeris. Letters stay here because measured
# against real sent letters, celeris-1 was no faster and wrote weaker prose, and
# celeris-1-magnus took 7-10s. Not needed if COVER_LETTER_MODE=reuse.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- Celeris (browser agent + every structured model call) ---
# Required. Drives the apply form, and runs the fit check, resume choice, page
# classification and screening answers. The rails in src/agent/guards.ts still
# decide what may be submitted.
CELERIS_API_KEY=
# Root only — the model id is a path segment Celeris derives per request.
CELERIS_BASE_URL=https://inference.celeris.ai
CELERIS_TIMEOUT_MS=45000

# Ceilings on a single application. An agent loop has no natural stopping
# point, so these are what bound both wall-clock and spend.
AGENT_MAX_STEPS=24
AGENT_MAX_MS=240000
AGENT_BUDGET_USD=0.05
# Turns with no page change before escalating to celeris-1-magnus (reasoning).
AGENT_ESCALATE_AFTER=2
# Attach a screenshot once a step stalls; celeris-1 accepts image input.
AGENT_SCREENSHOTS=true
AGENT_MAX_TRANSCRIPT_TOKENS=60000

# --- Optional local cover-letter humanizer (AuthorMist via llama.cpp) ---
# Leave URL empty to disable it. Unsafe rewrites fall back to Gemini's grounded draft.
HUMANIZER_URL=http://127.0.0.1:8091
HUMANIZER_MODEL=authormist-originality
HUMANIZER_REQUIRED=true
HUMANIZER_TIMEOUT_MS=120000

# --- Browser: reuse the already-signed-in Chrome profile ---
# The bot never automates login. Sign in manually in this profile first.
CHROME_PROFILE_DIR=/path/to/chrome-profile
CHROME_PATH=/path/to/chrome
HEADLESS=false

# --- Candidate ---
PROFILE_PATH=/path/to/profile.txt
EXPERIENCE_SUMMARY=Replace with a short, accurate summary of your experience.
SKILLS=Replace,with,your,verified,skills
SECURITY_CLEARANCE=Replace with your verified status
EXCLUDED_DOMAINS=Replace with technologies or domains outside your target roles

# --- Search ---
# Spans the whole resume: full-stack, React/frontend, Node/backend, React
# Native/mobile, Firebase, the AI & automation half, and early-career variants.
KEYWORDS=full stack developer,full stack engineer,full stack javascript,web developer,react developer,frontend developer react,frontend engineer,next.js developer,node.js developer,backend developer node,javascript engineer,typescript developer,react native developer,mobile developer react native,firebase developer,ai engineer,ai engineer python,ai automation engineer,llm engineer,python developer,junior software engineer,graduate software engineer
MAX_AGE_DAYS=14
MIN_SALARY=70000
MIN_HOURLY_RATE=25
MIN_SCORE=60
ONSITE_CITY=Sydney

# --- Rate limits ---
# Kept deliberately low: SEEK Pass walls and Indeed CAPTCHAs both appeared
# after ~44 applications in a single day. Raising these invites the same.
MAX_APPS_PER_RUN=8
MAX_APPS_PER_DAY=20
MIN_DELAY_MS=25000
MAX_DELAY_MS=70000
# Short paced gap after skipped/blocked attempts that submitted nothing.
MIN_NON_SUBMIT_DELAY_MS=3000
MAX_NON_SUBMIT_DELAY_MS=8000
SEARCH_DELAY_MS=6000
FIT_CONCURRENCY=3
FRICTION_ABORT=2

# Rehearsal mode: opens Quick Apply, writes the cover letter, answers every
# screening question — then stops at the final Submit and prints what it would
# have sent. Nothing reaches an employer. Run this before your first live run.
DRY_RUN=false
# Optional Cloudflare Turnstile/interstitial click solver (Python bridge).
# Install requirements-captcha.txt first. Unsupported/failed challenges need a human.
CAPTCHA_SOLVER=off
# CAPTCHA_PYTHON=C:/path/to/python.exe
# Local browser launches use CDP_PORT if set, otherwise localhost:9222.

# ---------------------------------------------------------------------------
# Hosting the dashboard for other people (see DEPLOYMENT.md)
# ---------------------------------------------------------------------------
# Everything below is per-installation. Each account's own search settings,
# résumés, knowledge and Gmail token live in Postgres, not here — the values
# in this file are only defaults and machine configuration.

# Postgres. Required: the dashboard keeps every account's data here.
DATABASE_URL=postgresql://myasis:change-me@127.0.0.1:5432/myasis

# Google sign-in, and the same client is reused for the optional read-only
# Gmail connection that lets a run enter emailed verification codes. Add both
# redirect URIs to the client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to http://localhost:5180/api/auth/callback/google for local use.
# OAUTH_REDIRECT_URI=https://your-domain/api/auth/callback/google
# APP_BASE_URL=https://your-domain
# Comma-separated. Admins have no application, employer-site or run-size caps.
ADMIN_EMAILS=

# Each run launches its own Chrome on its own account's profile, on the shared
# virtual display the installer sets up. Attaching to one shared browser
# instead would ignore those profiles and apply from a single SEEK session.
BROWSER_CONNECT_CDP=false
CDP_HOST=127.0.0.1
CDP_PORT=9333

# How many accounts may run at once. Each holds a Chrome, roughly 1.2 GB, so
# this is a memory ceiling: 1 on a 4 GB box, 2-3 on 8 GB, 6 on 16 GB. Set it
# in ecosystem.config.cjs or with `pm2 set myasis-dashboard:MAX_CONCURRENT_RUNS`.
# MAX_CONCURRENT_RUNS=3
