# --- Celeris (required): the only model provider ---
# celeris-1 extracts, tags and reads screenshots; celeris-1-magnus plans,
# browses, analyses and writes the brief.
CELERIS_API_KEY=
CELERIS_BASE_URL=https://inference.celeris.ai
CELERIS_TIMEOUT_MS=90000
CELERIS_MAX_OUTPUT_TOKENS=8192
# Model calls in flight at once; the workspace output-tokens-per-minute quota is shared.
CELERIS_CONCURRENCY=4

# --- Run limits ---
# Hard ceilings on one research run. Collection stops at 75% of the budget so
# analysis and the write-up always have room.
SCOUT_BUDGET_USD=1.5
SCOUT_MAX_MS=1800000
# Browser tabs (and tasks) at once. Requests to one host are always one at a time.
SCOUT_CONCURRENCY=3

# --- Browser agent ---
AGENT_MAX_STEPS=30
AGENT_ESCALATE_AFTER=2
AGENT_SCREENSHOTS=true

# --- Browser ---
# Live competitor discovery uses browser searches; no search-provider API key.
SCOUT_WEB_SEARCH=true
# Headed by default: headless Chrome announces itself and Cloudflare-fronted
# sites (LinkedIn) refuse it. On a server, run inside a virtual display (Xvfb).
HEADLESS=false
# A logged-out profile used only by the scout. Never point this at a personal, signed-in profile.
SCOUT_PROFILE_DIR=.scout/profile
# Optional: a specific Chrome. Otherwise installed Chrome, then patchright's Chromium.
CHROME_PATH=
# Optional outbound proxy for the browser, e.g. http://user:pass@host:port
SCOUT_PROXY=
SCOUT_LOCALE=en-AU
SCOUT_TIMEZONE=Australia/Sydney

# --- Politeness ---
PER_HOST_DELAY_MS=2500
RESPECT_ROBOTS=true
SCOUT_UA_TOKEN=MarketScout

# --- Optional official APIs (each one upgrades its source) ---
# Meta Ad Library API: commercial ads only for EU/UK countries (DSA). Elsewhere the public library page is used.
META_AD_LIBRARY_TOKEN=
META_GRAPH_VERSION=v23.0
# Instagram business_discovery: your own Business/Creator account id and token.
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=
# YouTube Data API v3 (10,000 free units a day).
YOUTUBE_API_KEY=
# Reddit Data API — required for Reddit (its anonymous endpoints are closed).
# Create a "script" app at https://www.reddit.com/prefs/apps. The free tier is non-commercial.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=node:market-scout:1.0 (by /u/your_username)
# Pinterest Trends API (developer app, trial access is enough).
PINTEREST_ACCESS_TOKEN=

SCOUT_DATA_DIR=.scout
